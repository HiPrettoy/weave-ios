      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup & restore"
          }
        }
      }
    },
    "备份失败：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup failed: %@"
