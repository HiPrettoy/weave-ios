<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>织识</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- 备份是一个 zip 包（weave-store.json + Images/），所以声明服从 public.zip-archive；
	     但仍然能导入旧版的纯 JSON 备份（见 AppStore.restore 的魔数判断）。 -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.weave.backup</string>
			<key>UTTypeDescription</key>
			<string>织识备份</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>weave</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- 让 App 的 Documents 出现在「文件」App 里：
	     系统文件选择器（fileImporter）在真机上点不动文件网格，
	     恢复备份不能只有那一条路。开着共享之后，用户把 .weave 拖进
	     「我的 iPhone › 织识 › Backups」即可，设置页会直接列出来。 -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>织识需要相机权限，拍下书页、板书或屏幕，并提取其中的文字。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>织识需要麦克风权限，把你说的内容转成文字笔记。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>织识需要语音识别权限，把录音转写为可检索的文字。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>织识需要相册权限，从已有图片中提取文字。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>织识在连接你自己局域网里的 vLLM / Ollama 等本地模型服务时需要访问本地网络。</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 本地模型服务通常是 http://192.168.x.x，只放开局域网，不改全局 ATS -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
